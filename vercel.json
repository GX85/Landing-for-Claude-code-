{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": { "maxDuration": 300 }
  },
  "redirects": [{ "source": "/app.html", "destination": "/app", "permanent": false }],
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/app/:path*", "destination": "/index.html" }
  ]
}
